# What `gcloud run deploy --source .` / `gcloud builds submit` uploads to Google. The
# Dockerfile only needs server/ and src/app/domain/; everything below is kept out of the upload.
#!include:.gitignore

.git
.env
**/.env
**/.env.*
!**/.env.example
node_modules
android/
www/
docs/
*.png
*.jpg
*.jpeg
*.webp
*.pdf
