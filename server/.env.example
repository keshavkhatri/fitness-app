# Copy to server/.env (git-ignored) for local runs. Never commit real values
# and never put the API key in the Angular app or its environment files.

# Required for extraction; without them the endpoint answers 503 not-configured.
OPENAI_API_KEY=
# A vision-capable model that supports Structured Outputs on the Responses API.
OPENAI_MODEL=

# Optional (defaults shown).
# OPENAI_MAX_OUTPUT_TOKENS=8000
# OPENAI_TIMEOUT_MS=90000
# INBODY_MAX_UPLOAD_BYTES=8388608
# Extractions processed at once (each holds one upload in memory); more get 503 server-busy.
# MAX_CONCURRENT_EXTRACTIONS=4
# Exact app origins, comma-separated (Capacitor: iOS capacitor://localhost, Android https://localhost).
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200
# RATE_LIMIT_PER_CLIENT=5
# RATE_LIMIT_WINDOW_MS=900000
# DAILY_EXTRACTION_LIMIT=200
# Only behind a trusted proxy that sets it, e.g. x-forwarded-for.
# CLIENT_IP_HEADER=
# HOST=127.0.0.1
# PORT=8787
