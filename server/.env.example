# Copy to server/.env (git-ignored) for local runs. Never commit real values
# and never put the API key in the Angular app or its environment files.

# Required for extraction; without them the endpoint answers 503 not-configured.
OPENAI_API_KEY=
# A vision-capable model that supports Structured Outputs on the Responses API.
OPENAI_MODEL=

# Optional (defaults shown).
# OPENAI_MAX_OUTPUT_TOKENS=16000
# OPENAI_TIMEOUT_MS=90000
# INBODY_MAX_UPLOAD_BYTES=8388608
# Extractions processed at once (each holds one upload in memory); more get 503 server-busy.
# MAX_CONCURRENT_EXTRACTIONS=4
# Exact app origins, comma-separated (Capacitor: iOS capacitor://localhost, Android https://localhost).
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200
# RATE_LIMIT_PER_CLIENT=5
# RATE_LIMIT_WINDOW_MS=900000
# DAILY_EXTRACTION_LIMIT=200
# Only behind a trusted proxy that sets it, e.g. x-forwarded-for (Cloud Run: see server/CLOUD_RUN.md).
# CLIENT_IP_HEADER=
# Local runs listen on 127.0.0.1:8787. NODE_ENV=production (set by the Dockerfile) makes HOST
# default to 0.0.0.0. On Cloud Run leave both unset: the platform supplies PORT.
# HOST=127.0.0.1
# PORT=8787

# --- PostgreSQL (Neon). Optional until the database phases; see server/DATABASE.md ---------
# The app's runtime connection. On Neon use the POOLED string (host contains "-pooler"). It carries
# the password: put the real value only in this git-ignored file or in Secret Manager.
# TLS is required for any host except localhost; sslmode=disable is refused for remote hosts.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Used only by `npm run server:migrate`: the DIRECT (non-pooled) Neon string. Falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require
# A local Postgres for development (TLS is optional on localhost only):
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/stokeform_dev
# Pool tuning (defaults shown).
# DATABASE_POOL_MAX=5
# DATABASE_IDLE_TIMEOUT_MS=10000
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Accounts (Better Auth). Optional: unset BETTER_AUTH_SECRET = accounts off. See server/AUTH.md ---
# Needs DATABASE_URL and the migrations (0006, 0007). At least 32 random characters; generate it as
# AUTH.md shows. Changing it signs everyone out. Use a different value per environment.
# BETTER_AUTH_SECRET=<generate>
# The server's public origin (no path). http is allowed for localhost only.
# BETTER_AUTH_URL=http://localhost:8787
# Email confirmation. Without EMAIL_DELIVERY, email/password accounts are off (addresses must be confirmed).
# Local development: write emails as files to server/.dev-outbox (git-ignored) instead of sending them.
# EMAIL_DELIVERY=dev-outbox
# Real email through Resend (verified sending domain; the key is a secret: Secret Manager on Cloud Run):
# EMAIL_DELIVERY=resend
# RESEND_API_KEY=<key>
# EMAIL_FROM=StokeForm <no-reply@your-domain>
# Google sign-in: a "Web application" OAuth client. Both or neither. Redirect URI to register:
# <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=<client id>
# GOOGLE_CLIENT_SECRET=<client secret>
# Where Google sign-in may return (defaults to the Android app's deep link). Add the web page for development:
# AUTH_APP_REDIRECT_URLS=com.fitnessapp.app://auth/callback,http://localhost:4200/auth/callback
# AUTH_SESSION_DAYS=30
# ALLOWED_ORIGINS above is also the accounts' trusted-origin list: include https://localhost to test the Android app.

# Cloud Run does not read this file, and EMAIL_DELIVERY=dev-outbox is refused there. On the service,
# the secrets below are Secret Manager secrets (named exactly like the variable: OPENAI_API_KEY,
# DATABASE_URL, BETTER_AUTH_SECRET, RESEND_API_KEY, GOOGLE_CLIENT_SECRET), never plain variables:
#   plain:   OPENAI_MODEL, ALLOWED_ORIGINS=https://localhost,capacitor://localhost, CLIENT_IP_HEADER=x-forwarded-for,
#            BETTER_AUTH_URL=<public https service URL>, EMAIL_DELIVERY=resend, EMAIL_FROM=<verified sender>,
#            GOOGLE_CLIENT_ID=<client id>
# Never use real production values in this file: it is for local runs, which today reach the same database.
# Real email setup and a safe test: `npm run server:email:test -- --to <your address>` (server/AUTH.md).
# Use a throwaway file for real Resend values, never this one: server/.env.resend-test (git-ignored).
