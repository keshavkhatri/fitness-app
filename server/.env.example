# Copy to server/.env (git-ignored) for local runs. Never commit real values
# and never put the API key in the Angular app or its environment files.

# Required for extraction; without them the endpoint answers 503 not-configured.
OPENAI_API_KEY=
# A vision-capable model that supports Structured Outputs on the Responses API.
OPENAI_MODEL=

# Optional (defaults shown).
# OPENAI_MAX_OUTPUT_TOKENS=8000
# OPENAI_TIMEOUT_MS=90000
# INBODY_MAX_UPLOAD_BYTES=8388608
# Extractions processed at once (each holds one upload in memory); more get 503 server-busy.
# MAX_CONCURRENT_EXTRACTIONS=4
# Exact app origins, comma-separated (Capacitor: iOS capacitor://localhost, Android https://localhost).
ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200
# RATE_LIMIT_PER_CLIENT=5
# RATE_LIMIT_WINDOW_MS=900000
# DAILY_EXTRACTION_LIMIT=200
# Only behind a trusted proxy that sets it, e.g. x-forwarded-for (Cloud Run: see server/CLOUD_RUN.md).
# CLIENT_IP_HEADER=
# Local runs listen on 127.0.0.1:8787. NODE_ENV=production (set by the Dockerfile) makes HOST
# default to 0.0.0.0. On Cloud Run leave both unset: the platform supplies PORT.
# HOST=127.0.0.1
# PORT=8787

# --- PostgreSQL (Neon). Optional until the database phases; see server/DATABASE.md ---------
# The app's runtime connection. On Neon use the POOLED string (host contains "-pooler"). It carries
# the password: put the real value only in this git-ignored file or in Secret Manager.
# TLS is required for any host except localhost; sslmode=disable is refused for remote hosts.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Used only by `npm run server:migrate`: the DIRECT (non-pooled) Neon string. Falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require
# A local Postgres for development (TLS is optional on localhost only):
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/pulseform_dev
# Pool tuning (defaults shown).
# DATABASE_POOL_MAX=5
# DATABASE_IDLE_TIMEOUT_MS=10000
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# Cloud Run does not read this file. Set these as service environment variables, and give
# OPENAI_API_KEY and DATABASE_URL to the service from Secret Manager, never as plain variables:
#   OPENAI_MODEL=<model>
#   ALLOWED_ORIGINS=https://localhost,capacitor://localhost
