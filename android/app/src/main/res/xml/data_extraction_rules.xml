<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. Nothing leaves this phone through Android's own backup or a phone-to-phone transfer:
  the person's data is backed up by their StokeForm account instead (and its encryption key lives in the device keystore,
  so a copied-over file could not be read anyway).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
