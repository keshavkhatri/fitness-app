{
  "name": "fitness-app",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "server:build": "npm --prefix server run build",
    "server:start": "npm run server:build && node --env-file-if-exists=server/.env server/dist/main.mjs",
    "server:test": "vitest run --config server/vitest.config.ts",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:install": "npm --prefix server ci",
    "server:migrate": "npm run server:build && node --env-file-if-exists=server/.env server/dist/migrate.mjs up",
    "server:migrate:status": "npm run server:build && node --env-file-if-exists=server/.env server/dist/migrate.mjs status"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@capacitor/cli": "8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/node": "^26.6.4",
    "angular-eslint": "22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.0.18"
  },
  "description": "Cross-platform fitness app (Ionic + Angular + Capacitor)"
}
